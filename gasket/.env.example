# =============================================================================
# gasket environment configuration
# Copy this file to .env and fill in real values.
# This file is the source of truth — see docs/usage.md §10 for full reference.
# =============================================================================

# ── LLM connection (required) ───────────────────────────────────────────────
# Any OpenAI-compatible service (DeepSeek/Zhipu/xAI/Groq/Ollama/vLLM) or Anthropic.
GASKET_LLM_BASE_URL=https://api.deepseek.com/v1
GASKET_LLM_KEY=your-api-key
GASKET_LLM_MODEL=deepseek-chat
# Protocol family: openai (default) or anthropic
GASKET_LLM_API=openai

# ── Proxy (optional) ────────────────────────────────────────────────────────
# GASKET_LLM_PROXY=http+https://proxy:8080
# GASKET_LLM_HTTP_PROXY=http://proxy:8080
# GASKET_LLM_HTTPS_PROXY=https://proxy:8080

# Tool traffic proxy for fetch / web_search (http, https, socks5, socks5h).
# The desktop app configures this via its UI; the UI value wins over this var.
# GASKET_TOOL_PROXY=socks5://127.0.0.1:1080

# ── Inference loop tunables (optional, defaults shown) ──────────────────────
# GASKET_MAX_TURNS=50
# GASKET_MAX_TOOL_CALLS=20
# GASKET_MAX_TOKENS=4096
# GASKET_THINKING=off
# GASKET_RETRY_MAX=2
# GASKET_RETRY_INITIAL_MS=500
# GASKET_RETRY_MAX_MS=8000

# ── Gateway server ──────────────────────────────────────────────────────────
# GASKET_GATEWAY_PORT=3000
# GASKET_GATEWAY_STATIC_DIR=../web/dist
# GASKET_GATEWAY_MODE=auto-edit
# GASKET_APPROVAL_TIMEOUT_S=300

# ── Context compaction ──────────────────────────────────────────────────────
# GASKET_CONTEXT_WINDOW=128000
# GASKET_COMPACT_THRESHOLD_PCT=80
# GASKET_COMPACT_TARGET_PCT=50
# GASKET_COMPACT_MAX_MESSAGES=80

# ── Tools / MCP / Search ────────────────────────────────────────────────────
# External command tools whitelist (comma-separated)
# GASKET_EXTERNAL_TOOLS=rg,jq
# MCP config file path (default ~/.gasket/mcp.json)
# GASKET_MCP_CONFIG=/path/to/mcp.json
# MCP call timeout in seconds (default 60)
# GASKET_MCP_CALL_TIMEOUT_S=60
# Fetch tool: allow private/internal network targets (SSRF guard is on by
# default — blocks 127.x/10.x/172.16-31.x/192.168.x/169.254.x/::1 and any
# hostname resolving into them). Set to 1 only for trusted self-hosted LANs.
# GASKET_FETCH_ALLOW_PRIVATE_NET=0

# Set to 1 to run bash tool commands in a filesystem sandbox (writes confined
# to cwd/TMPDIR/var/tmp; macOS sandbox-exec / Linux landlock -- Linux requires
# building with --features sandbox-landlock, otherwise fail-closed).
# GASKET_SANDBOX=1

# Search provider (requires `ext` feature on CLI)
# GASKET_SEARCH_PROVIDER=brave
# GASKET_BRAVE_API_KEY=
# GASKET_TAVILY_API_KEY=
# GASKET_SERPER_API_KEY=
# GASKET_SERPAPI_API_KEY=
# GASKET_EXA_API_KEY=
# GASKET_FIRECRAWL_API_KEY=

# ── Frontend (web/.env, not this file) ──────────────────────────────────────
# VITE_WS_URL=ws://localhost:3000
# VITE_API_URL=http://localhost:3000
