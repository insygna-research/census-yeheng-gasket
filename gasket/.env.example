# =============================================================================
# gasket Channel E2E Test Environment Variables
# Copy this file to .env and fill in real values to run E2E tests
# =============================================================================

# --- gasket agent (LLM connection + loop tunables) ---
# Required for real LLM calls; without these cli_host falls back to a mock.
GASKET_LLM_BASE_URL=https://api.deepseek.com/v1
GASKET_LLM_KEY=your-api-key
GASKET_LLM_MODEL=deepseek-chat
# openai (default) or anthropic
GASKET_LLM_API=openai
# Optional proxy: GASKET_LLM_PROXY / GASKET_LLM_HTTP_PROXY / GASKET_LLM_HTTPS_PROXY

# Loop tunables (all optional, shown with defaults commented out)
# GASKET_MAX_TURNS=50
# GASKET_MAX_TOOL_CALLS=20
# GASKET_MAX_TOKENS=4096
# GASKET_THINKING=off
# GASKET_RETRY_MAX=2
# GASKET_RETRY_INITIAL_MS=500
# GASKET_RETRY_MAX_MS=8000
