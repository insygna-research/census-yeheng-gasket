# =============================================================================
# conga environment configuration
# Copy this file to .env and fill in real values.
# NOTE: the web UI can override the LLM groups below at runtime - settings
# saved there persist to ~/.conga/settings.json and win over this file
# (re-read before every LLM call). The same dialog also stores a custom
# system prompt. See docs/usage.md.

# ── LLM connection (required) ───────────────────────────────────────────────
# Any OpenAI-compatible service (DeepSeek/Zhipu/xAI/Groq/Ollama/vLLM) or Anthropic.
CONGA_LLM_BASE_URL=https://api.deepseek.com/v1
CONGA_LLM_KEY=your-api-key
CONGA_LLM_MODEL=deepseek-chat
# Protocol family: openai (default) or anthropic
CONGA_LLM_API=openai

# ── Fast model for sub-agents (optional) ───────────────────────────────────
# A COMPLETE set routes sub-agents to a cheaper model; unset = same model as
# the main agent. A PARTIAL set (typo) fails loud at startup.
# CONGA_FAST_LLM_BASE_URL=https://api.deepseek.com/v1
# CONGA_FAST_LLM_KEY=your-fast-key
# CONGA_FAST_LLM_MODEL=deepseek-chat
# CONGA_FAST_LLM_API=openai

# ── Proxy (optional) ────────────────────────────────────────────────────────
# CONGA_LLM_PROXY=http+https://proxy:8080
# CONGA_LLM_HTTP_PROXY=http://proxy:8080
# CONGA_LLM_HTTPS_PROXY=https://proxy:8080

# Tool traffic proxy for fetch / web_search (http, https, socks5, socks5h).
# The desktop app configures this via its UI; the UI value wins over this var.
# CONGA_TOOL_PROXY=socks5://127.0.0.1:1080

# ── Inference loop tunables (optional, defaults shown) ──────────────────────
# CONGA_MAX_TURNS=50
# CONGA_MAX_TOOL_CALLS=20
# CONGA_MAX_TOKENS=4096
# CONGA_THINKING=off
# CONGA_RETRY_MAX=2
# CONGA_RETRY_INITIAL_MS=500
# CONGA_RETRY_MAX_MS=8000

# ── Gateway server ──────────────────────────────────────────────────────────
# CONGA_GATEWAY_PORT=3000
# CONGA_GATEWAY_STATIC_DIR=../web/dist
# CONGA_GATEWAY_MODE=auto-edit
# CONGA_APPROVAL_TIMEOUT_S=300

# ── Context compaction ──────────────────────────────────────────────────────
# CONGA_CONTEXT_WINDOW=128000
# CONGA_COMPACT_THRESHOLD_PCT=80
# CONGA_COMPACT_TARGET_PCT=50
# CONGA_COMPACT_MAX_MESSAGES=80

# ── Tools / MCP / Search ────────────────────────────────────────────────────
# External command tools whitelist (comma-separated)
# CONGA_EXTERNAL_TOOLS=rg,jq
# MCP config file path (default ~/.conga/mcp.json)
# CONGA_MCP_CONFIG=/path/to/mcp.json
# MCP call timeout in seconds (default 60)
# CONGA_MCP_CALL_TIMEOUT_S=60
# Fetch tool: allow private/internal network targets (SSRF guard is on by
# default — blocks 127.x/10.x/172.16-31.x/192.168.x/169.254.x/::1 and any
# hostname resolving into them). Set to 1 only for trusted self-hosted LANs.
# CONGA_FETCH_ALLOW_PRIVATE_NET=0

# Set to 1 to run bash tool commands in a filesystem sandbox (writes confined
# to cwd/TMPDIR/var/tmp; macOS sandbox-exec / Linux landlock -- Linux requires
# building with --features sandbox-landlock, otherwise fail-closed).
# CONGA_SANDBOX=1

# Project directory the agent works on: tool sandbox root and base for
# <dir>/.conga/skills project skills. Servers (gateway, desktop app) don't
# run inside the project they serve — set this to the project root there.
# Unset = process cwd (CLI default).
# CONGA_PROJECT_DIR=/path/to/your/project

# Search provider (requires `ext` feature on CLI)
# CONGA_SEARCH_PROVIDER=brave
# CONGA_BRAVE_API_KEY=
# CONGA_TAVILY_API_KEY=
# CONGA_SERPER_API_KEY=
# CONGA_SERPAPI_API_KEY=
# CONGA_EXA_API_KEY=
# CONGA_FIRECRAWL_API_KEY=

# ── Frontend (web/.env, not this file) ──────────────────────────────────────
# VITE_WS_URL=ws://localhost:3000
# VITE_API_URL=http://localhost:3000
